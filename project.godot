; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="UNBOUND"
run/main_scene="res://scenes/boot/Boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="uid://d2n4gg6cljme7"

[autoload]

GameState="*res://scripts/core/game_state.gd"
SceneTransition="*res://scripts/core/scene_transition.gd"
DialogueManager="*uid://c3rodes2l3gxb"
DialoguePresentation="*res://scripts/dialogue/dialogue_presentation.gd"
UnboundDialogue="*res://scripts/dialogue/unbound_dialogue_controller.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
mouse_cursor/custom_image="uid://bk50uv1ntbqp3"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

